# Secrets for the send-sms Edge Function. Never commit real values.
# Hosted:  supabase secrets set --env-file supabase/functions/.env   (or one by one)
# Local:   copy to supabase/functions/.env (git-ignored). Not needed when you sign in
#          with the test numbers in supabase/config.toml.
SEND_SMS_HOOK_SECRET=v1,whsec_replace-with-secret-from-dashboard
TERMII_API_KEY=replace-with-termii-api-key
TERMII_SENDER_ID=replace-with-approved-sender-id
TERMII_BASE_URL=https://replace-with-your-termii-base-url
# Optional: "dnd" (default, reaches DND-registered numbers) or "generic"
TERMII_CHANNEL=dnd
